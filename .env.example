# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_DB=nestshift
INFLUXDB_ADMIN_USER=nestshift
INFLUXDB_ADMIN_PASSWORD=changeme

# API
DATABASE_PATH=/app/database/nestshift.db
API_URL=http://nestshift-api:8000

# Dashboard
VITE_API_URL=http://localhost:8000

# Security
JWT_SECRET=dev-secret-change-in-prod-minimum-32-chars
MQTT_TLS_ENABLED=false
MQTT_CERT_PATH=/opt/nestshift/certs

# Feature flags
GPIO_MOCK=true
ENERGY_AGENT_ENABLED=false
AUTOMATION_AGENT_ENABLED=false