[Unit]
Description=NestShift Dashboard
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=nestshift
WorkingDirectory=/opt/nestshift/dashboard
ExecStart=/opt/nestshift/dashboard/node_modules/.bin/vite --host 0.0.0.0 --port 3000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target