[Unit]
Description=NestShift Kiosk (Local Display)
After=graphical.target nestshift-dashboard.service
Wants=nestshift-dashboard.service

[Service]
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/nestshift/.Xauthority
Type=simple
User=nestshift
ExecStart=/usr/bin/chromium-browser \
    --noerrdialogs \
    --disable-infobars \
    --kiosk http://localhost:3000 \
    --window-position=0,0 \
    --window-size=1920,1080 \
    --user-data-dir=/home/nestshift/.config/chromium-kiosk
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
