[Unit]
Description=NestShift Automation Agent
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=nestshift
WorkingDirectory=/opt/nestshift/services/automation-agent
ExecStart=/opt/nestshift/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target